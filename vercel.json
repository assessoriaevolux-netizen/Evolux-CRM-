{
  "rewrites": [
    { "source": "/crm", "destination": "/crm.html" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/exclusao-de-dados", "destination": "/exclusao-de-dados.html" },
    { "source": "/indicar", "destination": "/indicar.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(crm|privacidade|exclusao-de-dados|indicar)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
